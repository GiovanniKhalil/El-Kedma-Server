{
  "entities": {
    "User": {
      "title": "User",
      "description": "Servant, stage leader, or general administrator account with multi-class tree assignments",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID", "maxLength": 128 },
        "fullName": { "type": "string", "description": "Full name of the servant/supervisor", "maxLength": 120 },
        "phone": { "type": "string", "description": "Phone number", "maxLength": 24 },
        "role": {
          "type": "string",
          "description": "Primary role in church service",
          "enum": ["amin_khedma_am", "amin_fasl", "mosaed_amin", "khadem", "general_dock"]
        },
        "assignedClass": { "type": "string", "description": "Primary assigned class or stage", "maxLength": 100 },
        "assignments": { "type": "array", "description": "Array of class/stage assignments ({ stageId, stageName, role })" },
        "avatarUrl": { "type": "string", "description": "Optional profile avatar URL", "maxLength": 1000 },
        "isProtectedRoot": { "type": "boolean", "description": "Protects root amin_khedma_am from deletion" },
        "isAdminAssistant": { "type": "boolean", "description": "Administrative assistant flag" },
        "canAssignMakhdomeen": { "type": "boolean", "description": "Permission to assign makhdomeen to classes" },
        "mustChangePassword": { "type": "boolean", "description": "Requires password update on next login" },
        "isFirstLogin": { "type": "boolean", "description": "Legacy flag for temporary password change" },
        "username": { "type": "string", "description": "Unique username (letters, dot, underscore)", "maxLength": 50 },
        "passwordHash": { "type": "string", "description": "Encrypted SHA-256 password hash", "maxLength": 128 },
        "createdAt": { "type": "string", "description": "Immutable creation timestamp", "maxLength": 40 },
        "updatedAt": { "type": "string", "description": "Last update timestamp", "maxLength": 40 }
      },
      "required": ["uid", "fullName", "phone", "role"]
    },
    "PendingRegistration": {
      "title": "PendingRegistration",
      "description": "Isolated pending servant registration queue awaiting general admin approval",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Applicant full name", "maxLength": 120 },
        "username": { "type": "string", "description": "Requested username", "maxLength": 50 },
        "phone": { "type": "string", "description": "Applicant phone number", "maxLength": 24 },
        "birthDate": { "type": "string", "description": "Birth date YYYY-MM-DD", "maxLength": 20 },
        "notes": { "type": "string", "description": "Optional notes", "maxLength": 500 },
        "status": { "type": "string", "description": "Approval status", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "description": "Submission timestamp", "maxLength": 40 }
      },
      "required": ["fullName", "username", "phone", "status", "createdAt"]
    },
    "Makhdoom": {
      "title": "Makhdoom",
      "description": "Child / attendee record (record-only, no login account)",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of the child", "maxLength": 120 },
        "birthDate": { "type": "string", "description": "Birth date in YYYY-MM-DD format", "maxLength": 20 },
        "stageId": { "type": "string", "description": "Primary stage ID", "maxLength": 64 },
        "stage": { "type": "string", "description": "Primary Sunday School stage", "maxLength": 100 },
        "secondaryStages": { "type": "array", "description": "Secondary activity stages" },
        "assignedServantId": { "type": "string", "description": "Follow-up servant UID", "maxLength": 128 },
        "classGroup": { "type": "string", "description": "Specific class group", "maxLength": 100 },
        "points": { "type": "number", "description": "Reward points count" },
        "phone": { "type": "string", "description": "Child phone number", "maxLength": 24 },
        "parentName": { "type": "string", "description": "Primary guardian name", "maxLength": 120 },
        "parentPhone": { "type": "string", "description": "Primary guardian phone", "maxLength": 24 },
        "parentRelation": { "type": "string", "description": "Primary guardian relation", "maxLength": 40 },
        "parentJob": { "type": "string", "description": "Primary guardian job", "maxLength": 100 },
        "parent2Name": { "type": "string", "description": "Secondary guardian name", "maxLength": 120 },
        "parent2Phone": { "type": "string", "description": "Secondary guardian phone", "maxLength": 24 },
        "parent2Relation": { "type": "string", "description": "Secondary guardian relation", "maxLength": 40 },
        "parent2Job": { "type": "string", "description": "Secondary guardian job", "maxLength": 100 }
      },
      "required": ["fullName", "stage"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Attendance event record with recordedByUid anti-self-attendance tracking",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date in YYYY-MM-DD", "maxLength": 20 },
        "month": { "type": "number", "description": "Month number 1-12" },
        "periodType": { "type": "string", "description": "Tracking period", "enum": ["weekly", "monthly", "seasonal_event"] },
        "personId": { "type": "string", "description": "ID of attendee", "maxLength": 128 },
        "personType": { "type": "string", "description": "child, servant, or supervisor", "maxLength": 30 },
        "eventType": { "type": "string", "description": "Event type", "maxLength": 40 },
        "status": { "type": "string", "description": "present, absent, late, or excused", "maxLength": 20 },
        "recordedByUid": { "type": "string", "description": "UID of servant recording attendance", "maxLength": 128 },
        "note": { "type": "string", "description": "Optional attendance note", "maxLength": 400 }
      },
      "required": ["date", "personId", "personType", "eventType", "status"]
    },
    "LibraryBook": {
      "title": "LibraryBook",
      "description": "Educational, spiritual, or preparation book with stage visibility",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Book title", "maxLength": 200 },
        "category": { "type": "string", "description": "spiritual, preparation, or legacy category", "maxLength": 50 },
        "visibility": { "type": "string", "description": "Visibility scope", "enum": ["all", "specific_stages"] },
        "targetGrade": { "type": "string", "description": "Primary target educational grade or stage", "maxLength": 100 },
        "targetStages": { "type": "array", "description": "List of target stage names" },
        "fileUrl": { "type": "string", "description": "URL or path of the PDF document", "maxLength": 2000 }
      },
      "required": ["title", "category", "targetGrade"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Church announcement with targeted scope (all, general_dock, specific_stages)",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Announcement title", "maxLength": 200 },
        "body": { "type": "string", "description": "Announcement content body", "maxLength": 2000 },
        "targetRole": { "type": "string", "description": "Target audience role or all", "maxLength": 100 },
        "targetScope": { "type": "string", "description": "Target scope", "enum": ["all", "general_dock", "specific_stages"] },
        "targetStages": { "type": "array", "description": "Target stage names when specific_stages" },
        "createdAt": { "type": "string", "description": "Creation timestamp", "maxLength": 40 }
      },
      "required": ["title", "body"]
    },
    "Stage": {
      "title": "Stage",
      "description": "Sunday school class/stage configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Stage ID", "maxLength": 64 },
        "name": { "type": "string", "description": "Stage display name", "maxLength": 100 },
        "description": { "type": "string", "description": "Stage description", "maxLength": 400 },
        "supervisorName": { "type": "string", "description": "Stage supervisor name", "maxLength": 120 },
        "supervisorPhone": { "type": "string", "description": "Stage supervisor phone", "maxLength": 24 },
        "meetingTime": { "type": "string", "description": "Weekly meeting time", "maxLength": 100 }
      },
      "required": ["id", "name"]
    },
    "SeasonalEvent": {
      "title": "SeasonalEvent",
      "description": "Church seasonal event (Mahragan, retreats, feasts)",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Event title", "maxLength": 200 },
        "date": { "type": "string", "description": "Event date YYYY-MM-DD", "maxLength": 20 },
        "stage": { "type": "string", "description": "Target stage or all", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "Creation timestamp", "maxLength": 40 }
      },
      "required": ["title", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Church servants, stage leaders, and general administrators"
    },
    "/pending_registrations/{regId}": {
      "schema": { "$ref": "#/entities/PendingRegistration" },
      "description": "Isolated queue for unauthenticated servant sign-up requests"
    },
    "/makhdomeen/{makhdoomId}": {
      "schema": { "$ref": "#/entities/Makhdoom" },
      "description": "Children and students in Sunday school"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Attendance tracking records"
    },
    "/library/{bookId}": {
      "schema": { "$ref": "#/entities/LibraryBook" },
      "description": "Library curriculum and spiritual books"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Broadcast announcements and notices"
    },
    "/stages/{stageId}": {
      "schema": { "$ref": "#/entities/Stage" },
      "description": "Sunday school stages and service groups"
    },
    "/seasonal_events/{eventId}": {
      "schema": { "$ref": "#/entities/SeasonalEvent" },
      "description": "Seasonal events and festival tracking"
    }
  }
}
